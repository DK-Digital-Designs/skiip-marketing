NEXT_PUBLIC_SITE_URL=http://localhost:3000

# v1 lead delivery
# Server-side Resend delivery with mailto fallback.
LEAD_DELIVERY=resend
RESEND_API_KEY=
LEAD_EMAIL_TO=hello@skiip.co.uk
LEAD_EMAIL_FROM=SKIIP Website <info@skiip.co.uk>

# Public fallback recipient used only when the browser opens mailto.
NEXT_PUBLIC_LEAD_EMAIL=hello@skiip.co.uk

# Deferred Supabase mode, not used for the static marketing-site launch.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional analytics
NEXT_PUBLIC_GA4_ID=

# Optional comma-separated LAN/dev hosts if needed by Next dev origin protection
NEXT_ALLOWED_DEV_ORIGINS=192.168.0.150
